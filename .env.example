# ─────────────────────────────────────────────────────────────────
# Root .env.example — shared defaults for the monorepo
#
# Copy to .env, apps/api/.env, and apps/web/.env for local development.
# NEVER commit real secrets. JWT secrets must be regenerated per env.
# ─────────────────────────────────────────────────────────────────

# === Database =====================================================
# Railway injects DATABASE_URL automatically in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grocery_dev?schema=public"

# === API (apps/api) ===============================================
NODE_ENV=development
PORT=3001
APP_VERSION=0.1.0

# API base path (information-only — actual prefix is hard-coded to
# `/api/v1` in apps/api/src/main.ts so the OpenAPI doc stays stable).
API_PREFIX=/api/v1

# === JWT (Phase 2 — currently unused by Foundation) ===============
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change_me_min_32_chars_xxxxxxxxxxxxxxxxxxxx"
JWT_REFRESH_SECRET="change_me_min_32_chars_xxxxxxxxxxxxxxxxxxxx"
# TTLs accept ms-style strings (`15m`, `7d`, `30d`).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_REMEMBER_ME=30d

# === Cookies ======================================================
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# === CORS / web origin ============================================
# The Web shell runs on Vite dev server at :5173 and proxies /api → :3001.
WEB_ORIGIN=http://localhost:5173

# === Logging ======================================================
# `info` in production. Use `debug` + LOG_PRETTY=true for local DX.
LOG_LEVEL=debug
LOG_PRETTY=true

# === Seed defaults (Phase 2 — pnpm db:seed) =======================
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=Owner@12345
SEED_OWNER_FULL_NAME=مالك المتجر
SEED_STORE_NAME=بقالتي

# === Web (apps/web) ===============================================
# In dev, Vite proxies /api → http://localhost:3001 (no need to set this).
# In prod, set the public API origin (no trailing slash). Example:
#   VITE_API_URL=https://api.example.com/api/v1
VITE_API_URL=

# Enable Service Worker locally (default off; set to "true" to test PWA).
VITE_ENABLE_SW=false
