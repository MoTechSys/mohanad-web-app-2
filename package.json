{
  "name": "grocery-system",
  "version": "0.1.0",
  "private": true,
  "description": "Online grocery store management system (PWA) — monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @grocery/api dev",
    "dev:web": "pnpm --filter @grocery/web dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky || true",
    "db:generate": "pnpm --filter @grocery/api prisma:generate",
    "db:migrate": "pnpm --filter @grocery/api prisma:migrate",
    "db:seed": "pnpm --filter @grocery/api prisma:seed",
    "db:studio": "pnpm --filter @grocery/api prisma:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.14.10",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.13.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
