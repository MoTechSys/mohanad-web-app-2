{
  "name": "grocery-system",
  "version": "0.1.0",
  "private": true,
  "description": "Online grocery store management system (PWA) — monorepo",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @grocery/api dev",
    "dev:web": "pnpm --filter @grocery/web dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky || true",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:format": "prisma format --schema=./prisma/schema.prisma",
    "db:validate": "prisma validate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test-users": "tsx prisma/seed-test-users.ts",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "lh": "node scripts/lighthouse.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^20.14.10",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "playwright": "^1.59.1",
    "prisma": "^5.22.0",
    "puppeteer-core": "23",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "pnpm": {
    "overrides": {
      "zod": "3.23.8"
    }
  }
}