# ─── App ─────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_VERSION=0.1.0

# ─── Database (Railway PostgreSQL) ───────────────
# في الإنتاج Railway تُحقن DATABASE_URL تلقائياً
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grocery_dev?schema=public"

# ─── JWT ─────────────────────────────────────────
JWT_ACCESS_SECRET="change_me_dev_only_access_secret_min_32_chars_xxx"
JWT_REFRESH_SECRET="change_me_dev_only_refresh_secret_min_32_chars_xx"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
JWT_REFRESH_TTL_REMEMBER_ME="30d"

# ─── CORS ────────────────────────────────────────
WEB_ORIGIN="http://localhost:5173"

# ─── Cookie ──────────────────────────────────────
COOKIE_DOMAIN=""
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"

# ─── Logging ─────────────────────────────────────
LOG_LEVEL="debug"
LOG_PRETTY="true"

# ─── Seed ────────────────────────────────────────
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="Owner@12345"
SEED_OWNER_FULL_NAME="مالك المتجر"
SEED_STORE_NAME="بقالتي"
